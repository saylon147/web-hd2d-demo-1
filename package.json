{
  "name": "web-hd2d-demo-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "assets:blockout": "node scripts/run_blender.mjs",
    "assets:blockout:v0": "node scripts/run_blender.mjs --v0",
    "assets:validate": "node scripts/validate_blockout.mjs",
    "assets:validate:v0": "node scripts/archive/validate_blockout_v0.mjs",
    "assets:reproduce": "node scripts/reproduce_blockout.mjs",
    "tripo:optimize": "node scripts/run_tripo.mjs",
    "tripo:validate": "node scripts/validate_tripo.mjs",
    "tripo:report": "node scripts/report_tripo.mjs",
    "tripo:pipeline": "node scripts/tripo_pipeline.mjs",
    "evidence:compare": "node scripts/compare_blockout.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
